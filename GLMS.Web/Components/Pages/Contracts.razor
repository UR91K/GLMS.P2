@page "/contracts"
@attribute [Authorize]
@inject GLMS.Web.Services.Contracts.IContractService ContractService
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Contracts</PageTitle>

<div class="page-shell">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="eyebrow">Contracts</p>
            <h1 class="page-title">Contracts workspace</h1>
        </div>
        <div class="button-row">
            <button class="button button-secondary" type="button" @onclick="LoadContractsAsync">Refresh list</button>
        </div>
    </header>

    @if (apiError is not null)
    {
        <section class="surface-card empty-state">
            <h2 class="empty-state-title">Unable to load contracts</h2>
            <p class="empty-state-copy">@apiError</p>
            <button class="button button-secondary" type="button" @onclick="LoadContractsAsync">Try again</button>
        </section>
    }
    else if (isLoading)
    {
        <section class="surface-card empty-state">
            <h2 class="empty-state-title">Loading contracts</h2>
            <p class="empty-state-copy">The contracts and linked client records are being read from the database.</p>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(transitionMessage))
        {
            <div class="validation-block @(transitionFailed ? string.Empty : "success-block")" style="margin-bottom: 1.5rem;">
                <p class="@(transitionFailed ? "validation-list" : "success-message")">@transitionMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(uploadMessage))
        {
            <div class="validation-block @(uploadFailed ? string.Empty : "success-block")" style="margin-bottom: 1.5rem;">
                <p class="@(uploadFailed ? "validation-list" : "success-message")">@uploadMessage</p>
            </div>
        }

        <section class="stats-grid">
            <article class="surface-card stat-card">
                <p class="stat-label">Contracts</p>
                <p class="stat-value">@contracts.Count</p>
                <p class="stat-meta">Total agreements currently in the system.</p>
            </article>

            <article class="surface-card stat-card">
                <p class="stat-label">Active</p>
                <p class="stat-value">@contracts.Count(contract => contract.Status == ContractStatus.Active)</p>
                <p class="stat-meta">Contracts that allow service requests right now.</p>
            </article>

            <article class="surface-card stat-card">
                <p class="stat-label">With signed PDF</p>
                <p class="stat-value">@contracts.Count(contract => contract.HasAgreementFile)</p>
                <p class="stat-meta">Records that already include an uploaded signed agreement.</p>
            </article>
        </section>

        <section class="surface-card section-card data-table-shell">
            <div class="toolbar">
                <div class="toolbar-group">
                    <input class="search-input"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           placeholder="Search by title or client"
                           aria-label="Search contracts" />
                </div>

                <div class="toolbar-group filters-group">
                    <label class="filter-field" for="contract-status-filter">
                        <span>Status</span>
                        <InputSelect id="contract-status-filter" class="field-control filter-control" @bind-Value="selectedStatusFilter">
                            <option value="">All statuses</option>
                            @foreach (var status in Enum.GetValues<ContractStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </label>

                    <label class="filter-field" for="contract-service-level-filter">
                        <span>Service level</span>
                        <InputSelect id="contract-service-level-filter" class="field-control filter-control" @bind-Value="selectedServiceLevelFilter">
                            <option value="">All levels</option>
                            @foreach (var serviceLevel in serviceLevelFilters)
                            {
                                <option value="@serviceLevel">@serviceLevel</option>
                            }
                        </InputSelect>
                    </label>

                    <label class="filter-field" for="contract-date-from">
                        <span>Start from</span>
                        <InputDate id="contract-date-from" class="field-control filter-control" TValue="DateTime?" @bind-Value="startDateFrom" />
                    </label>

                    <label class="filter-field" for="contract-date-to">
                        <span>End until</span>
                        <InputDate id="contract-date-to" class="field-control filter-control" TValue="DateTime?" @bind-Value="endDateTo" />
                    </label>

                    <button class="button button-secondary button-compact" type="button" @onclick="ClearFilters">Clear filters</button>
                </div>
            </div>

            <div class="toolbar">
                <div class="toolbar-group inline-note">
                    <span>@filteredContracts.Count result@(filteredContracts.Count == 1 ? string.Empty : "s")</span>
                    <span>&middot;</span>
                    <span>Sorted by nearest end date</span>
                </div>
            </div>

            @if (filteredContracts.Count == 0)
            {
                <div class="empty-state">
                    <h2 class="empty-state-title">No matching contracts</h2>
                    <p class="empty-state-copy">Try broadening your status or date range filters to locate agreements.</p>
                </div>
            }
            else
            {
                <table class="data-table contracts-table">
                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Client</th>
                            <th>Service level</th>
                            <th>Term</th>
                            <th>Status</th>
                            <th>Service requests</th>
                            <th>Agreement file</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in filteredContracts)
                        {
                            <tr>
                                <td data-label="Contract">
                                    <div class="stack">
                                        <strong>@contract.Title</strong>
                                        <span class="muted mono">CON-@contract.ContractId.ToString("D5")</span>
                                    </div>
                                </td>
                                <td data-label="Client">
                                    <div class="stack">
                                        <span>@contract.ClientName</span>
                                        <span class="muted mono">CLI-@contract.ClientId.ToString("D4")</span>
                                    </div>
                                </td>
                                <td data-label="Service level">
                                    <span class="pill pill-neutral">@contract.ServiceLevel</span>
                                </td>
                                <td data-label="Term">
                                    <div class="stack">
                                        <span>Start: @contract.StartDate.ToString("dd MMM yyyy")</span>
                                        <span>End: @contract.EndDate.ToString("dd MMM yyyy")</span>
                                        <span class="muted">@GetExpiryLabel(contract.EndDate)</span>
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <span class="pill @GetStatusPillClass(contract.Status)">@contract.Status</span>
                                </td>
                                <td data-label="Service requests">
                                    <span class="pill pill-neutral">@contract.ServiceRequestCount request@(contract.ServiceRequestCount == 1 ? string.Empty : "s")</span>
                                </td>
                                <td data-label="Agreement file">
                                    <button class="button button-secondary button-compact"
                                            type="button"
                                            @onclick="() => OpenFileModal(contract)">
                                        @(contract.HasAgreementFile ? "File options" : "Upload file")
                                    </button>
                                </td>
                                <td data-label="Actions" class="actions-cell">
                                    <DropdownMenu Placeholder="Actions"
                                                  AriaLabel=@($"Actions for {contract.Title}")
                                                  DisabledAriaLabel=@($"No actions available for {contract.Title}")
                                                  Disabled="@isTransitioning"
                                                  Options="@GetAvailableActions(contract.Status)"
                                                  OnSelect="@(action => HandleActionSelectionAsync(contract, action))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@if (fileModalContract is not null)
{
    <div class="modal-overlay" @onclick="CloseFileModal">
        <section class="surface-card modal-card file-options-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="file-modal-title"
                 @onclick:stopPropagation="true">
            <div>
                <p class="eyebrow">Agreement file</p>
                <h2 id="file-modal-title" class="empty-state-title">@fileModalContract.Title</h2>
            </div>

            @if (fileModalContract.HasAgreementFile)
            {
                <div class="file-detail-block">
                    <p class="info-label">Current file</p>
                    <p class="mono">@fileModalContract.PdfOriginalFileName</p>
                </div>
                <div>
                    <a class="button button-secondary"
                       href="@GetAgreementDownloadUrl(fileModalContract)"
                       download="@fileModalContract.PdfOriginalFileName">
                        Download PDF
                    </a>
                </div>
            }
            else
            {
                <p class="muted">No agreement file has been uploaded for this contract yet.</p>
            }

            <div class="file-upload-section">
                <p class="info-label">@(fileModalContract.HasAgreementFile ? "Replace file" : "Upload file") &mdash; PDF, max 10 MB</p>
                <InputFile OnChange="@(args => UploadAgreementFromModalAsync(fileModalContract.ContractId, args))"
                           accept=".pdf,application/pdf"
                           disabled="@isUploadingAgreement" />
                @if (isUploadingAgreement)
                {
                    <p class="muted" style="margin-top: 0.5rem; font-size: 0.88rem;">Uploading, please wait&hellip;</p>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(uploadMessage))
            {
                <div class="validation-block @(uploadFailed ? string.Empty : "success-block")">
                    <p class="@(uploadFailed ? "validation-list" : "success-message")">@uploadMessage</p>
                </div>
            }

            <div class="button-row dialog-actions">
                <button class="button button-secondary" type="button" @onclick="CloseFileModal">Close</button>
            </div>
        </section>
    </div>
}

@if (pendingConfirmContractId.HasValue && pendingConfirmAction.HasValue)
{
    <div class="modal-overlay" @onclick="CancelConfirm">
        <section class="surface-card modal-card contract-confirm-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="contract-confirm-title"
                 @onclick:stopPropagation="true">
            <p class="eyebrow">Confirmation required</p>
            <h2 id="contract-confirm-title" class="empty-state-title">@GetConfirmLabel(pendingConfirmAction.Value)</h2>
            <p class="page-subtitle">@GetConfirmDescription(pendingConfirmAction.Value, pendingConfirmContractTitle)</p>
            <div class="button-row dialog-actions">
                <button class="button button-danger" type="button"
                        disabled="@isTransitioning"
                        @onclick="ConfirmActionAsync">Confirm</button>
                <button class="button button-secondary" type="button"
                        disabled="@isTransitioning"
                        @onclick="CancelConfirm">Cancel</button>
            </div>
        </section>
    </div>
}

@code {
    private string _apiPublicBaseUrl = string.Empty;
    private List<ContractListItem> contracts = [];
    private string searchTerm = string.Empty;
    private string selectedStatusFilter = string.Empty;
    private string selectedServiceLevelFilter = string.Empty;
    private DateTime? startDateFrom;
    private DateTime? endDateTo;
    private bool isLoading = true;
    private string? apiError;
    private bool isTransitioning;
    private string? transitionMessage;
    private bool transitionFailed;
    private bool isUploadingAgreement;
    private string? uploadMessage;
    private bool uploadFailed;
    private int? pendingConfirmContractId;
    private string? pendingConfirmContractTitle;
    private ContractTransitionAction? pendingConfirmAction;
    private ContractListItem? fileModalContract;

    private IReadOnlyList<string> serviceLevelFilters => contracts
        .Select(contract => contract.ServiceLevel)
        .Where(level => !string.IsNullOrWhiteSpace(level))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(level => level)
        .ToList();

    private IReadOnlyList<ContractListItem> filteredContracts => contracts
        .Where(contract =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             contract.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             contract.ClientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (!TryGetSelectedStatus(out var selectedStatus) || contract.Status == selectedStatus) &&
            (string.IsNullOrWhiteSpace(selectedServiceLevelFilter) ||
             string.Equals(contract.ServiceLevel, selectedServiceLevelFilter, StringComparison.OrdinalIgnoreCase)) &&
            (!startDateFrom.HasValue || contract.StartDate.Date >= startDateFrom.Value.Date) &&
            (!endDateTo.HasValue || contract.EndDate.Date <= endDateTo.Value.Date))
        .OrderBy(contract => contract.EndDate)
        .ThenBy(contract => contract.Title)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _apiPublicBaseUrl = Configuration["ApiPublicBaseUrl"] ?? "http://localhost:5001";
        await LoadContractsAsync();
    }

    private async Task LoadContractsAsync()
    {
        isLoading = true;
        apiError = null;
        CancelConfirm();

        try
        {
            var contractRows = await ContractService.GetListAsync();

            contracts = contractRows
                .Select(contract => new ContractListItem(
                    contract.ContractId,
                    contract.ClientId,
                    contract.ClientName,
                    contract.Title,
                    contract.ServiceLevel,
                    contract.StartDate,
                    contract.EndDate,
                    contract.Status,
                    contract.ServiceRequestCount,
                    contract.PdfFileName,
                    contract.PdfOriginalFileName))
                .ToList();
        }
        catch (HttpRequestException)
        {
            apiError = "Could not reach the API. Make sure the GLMS.Api project is running.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatusFilter = string.Empty;
        selectedServiceLevelFilter = string.Empty;
        startDateFrom = null;
        endDateTo = null;
    }

    private async Task ChangeStatusAsync(int contractId, ContractTransitionAction action)
    {
        transitionMessage = null;
        transitionFailed = false;
        isTransitioning = true;

        var result = await ContractService.ChangeStatusAsync(contractId, action);

        transitionMessage = result.Message;
        transitionFailed = !result.Succeeded;

        if (result.Succeeded)
        {
            await LoadContractsAsync();
        }

        isTransitioning = false;
    }

    private async Task UploadAgreementAsync(int contractId, InputFileChangeEventArgs args)
    {
        uploadMessage = null;
        uploadFailed = false;

        var file = args.File;
        if (file is null)
        {
            return;
        }

        isUploadingAgreement = true;

        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var result = await ContractService.UploadAgreementAsync(
                contractId,
                file.Name,
                file.ContentType,
                file.Size,
                stream);

            uploadMessage = result.Message;
            uploadFailed = !result.Succeeded;

            if (result.Succeeded)
            {
                await LoadContractsAsync();
            }
        }
        catch (IOException)
        {
            uploadFailed = true;
            uploadMessage = "The selected file could not be read. Ensure it is a valid PDF under 10 MB.";
        }
        finally
        {
            isUploadingAgreement = false;
        }
    }

    private async Task HandleActionSelectionAsync(ContractListItem contract, string? value)
    {
        if (string.IsNullOrWhiteSpace(value) ||
            !Enum.TryParse<ContractTransitionAction>(value, out var action))
        {
            return;
        }

        if (RequiresConfirmation(action))
        {
            RequestConfirm(contract.ContractId, contract.Title, action);
            return;
        }

        await ChangeStatusAsync(contract.ContractId, action);
    }

    private void RequestConfirm(int contractId, string contractTitle, ContractTransitionAction action)
    {
        pendingConfirmContractId = contractId;
        pendingConfirmContractTitle = contractTitle;
        pendingConfirmAction = action;
    }

    private void CancelConfirm()
    {
        pendingConfirmContractId = null;
        pendingConfirmContractTitle = null;
        pendingConfirmAction = null;
    }

    private void OpenFileModal(ContractListItem contract)
    {
        fileModalContract = contract;
        uploadMessage = null;
        uploadFailed = false;
    }

    private void CloseFileModal()
    {
        fileModalContract = null;
        uploadMessage = null;
        uploadFailed = false;
    }

    private async Task UploadAgreementFromModalAsync(int contractId, InputFileChangeEventArgs args)
    {
        await UploadAgreementAsync(contractId, args);
        if (!uploadFailed)
        {
            CloseFileModal();
        }
    }

    private async Task ConfirmActionAsync()
    {
        if (pendingConfirmContractId is null || pendingConfirmAction is null)
        {
            return;
        }

        var contractId = pendingConfirmContractId.Value;
        var action = pendingConfirmAction.Value;

        CancelConfirm();
        await ChangeStatusAsync(contractId, action);
    }

    private static string GetConfirmLabel(ContractTransitionAction action) => action switch
    {
        ContractTransitionAction.Suspend => "Suspend this contract?",
        ContractTransitionAction.Expire => "Expire this contract?",
        _ => "Confirm this action?"
    };

    private static string GetConfirmDescription(ContractTransitionAction action, string? contractTitle) => action switch
    {
        ContractTransitionAction.Suspend => $"{contractTitle} will stop accepting new service work until it is resumed.",
        ContractTransitionAction.Expire => $"{contractTitle} will be marked as expired and can no longer be used for active service delivery.",
        _ => $"Apply this action to {contractTitle}."
    };

    private static bool CanApprove(ContractStatus status) => status == ContractStatus.Draft;
    private static bool CanSuspend(ContractStatus status) => status == ContractStatus.Active;
    private static bool CanResume(ContractStatus status) => status == ContractStatus.OnHold;
    private static bool CanExpire(ContractStatus status) =>
        status == ContractStatus.Active || status == ContractStatus.OnHold;

    private static bool RequiresConfirmation(ContractTransitionAction action) =>
        action is ContractTransitionAction.Suspend or ContractTransitionAction.Expire;

    private static IReadOnlyList<DropdownMenuOption> GetAvailableActions(ContractStatus status)
    {
        var options = new List<DropdownMenuOption>(4);

        if (CanApprove(status))
        {
            options.Add(new DropdownMenuOption(nameof(ContractTransitionAction.Approve), "Approve"));
        }

        if (CanSuspend(status))
        {
            options.Add(new DropdownMenuOption(nameof(ContractTransitionAction.Suspend), "Suspend"));
        }

        if (CanResume(status))
        {
            options.Add(new DropdownMenuOption(nameof(ContractTransitionAction.Resume), "Resume"));
        }

        if (CanExpire(status))
        {
            options.Add(new DropdownMenuOption(nameof(ContractTransitionAction.Expire), "Expire"));
        }

        return options;
    }

    private bool TryGetSelectedStatus(out ContractStatus status)
    {
        if (Enum.TryParse<ContractStatus>(selectedStatusFilter, out status))
        {
            return true;
        }

        status = default;
        return false;
    }

    private static string GetStatusPillClass(ContractStatus status) => status switch
    {
        ContractStatus.Active => "pill-active",
        ContractStatus.OnHold => "pill-onhold",
        ContractStatus.Expired => "pill-expired",
        _ => "pill-draft"
    };

    private static string GetExpiryLabel(DateTime endDate)
    {
        var days = (endDate.Date - DateTime.Today).Days;

        if (days < 0)
        {
            return $"Expired {Math.Abs(days)} day{(Math.Abs(days) == 1 ? string.Empty : "s")} ago";
        }

        if (days == 0)
        {
            return "Expires today";
        }

        return $"Expires in {days} day{(days == 1 ? string.Empty : "s")}";
    }

    private string GetAgreementDownloadUrl(ContractListItem contract) =>
        $"{_apiPublicBaseUrl}/api/contracts/{contract.ContractId}/agreement";

    private sealed record ContractListItem(
        int ContractId,
        int ClientId,
        string ClientName,
        string Title,
        string ServiceLevel,
        DateTime StartDate,
        DateTime EndDate,
        ContractStatus Status,
        int ServiceRequestCount,
        string? PdfFileName,
        string? PdfOriginalFileName)
    {
        public bool HasAgreementFile =>
            !string.IsNullOrWhiteSpace(PdfFileName) &&
            !string.IsNullOrWhiteSpace(PdfOriginalFileName);
    }
}