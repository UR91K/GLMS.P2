<div class="nav-shell surface-card">
    <div class="nav-brand-row">
        <a class="nav-brand" href="/clients">
            <span class="nav-brand-mark">TM</span>
            <span class="nav-brand-copy">
                <strong>TechMove</strong>
                <span>Leasing workspace</span>
            </span>
        </a>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.click()">
        <nav class="nav-links">
            <NavLink class="nav-link" href="/clients" Match="NavLinkMatch.Prefix">
                <span class="nav-link-text">Clients</span>
                <span class="nav-link-meta">Directory</span>
            </NavLink>

            <NavLink class="nav-link" href="/contracts" Match="NavLinkMatch.Prefix">
                <span class="nav-link-text">Contracts</span>
                <span class="nav-link-meta">Status and agreement files</span>
            </NavLink>

            <NavLink class="nav-link" href="/service-requests" Match="NavLinkMatch.Prefix">
                <span class="nav-link-text">Service Requests</span>
                <span class="nav-link-meta">Currency conversions and workflow</span>
            </NavLink>
        </nav>

        <AuthorizeView>
            <Authorized>
                <div class="nav-footer">
                    <button class="button button-secondary" type="button" @onclick="HandleLogoutAsync">
                        Sign out
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Inject] private GlmsAuthStateProvider AuthProvider { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task HandleLogoutAsync()
    {
        await AuthProvider.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}

